<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical">

    <androidx.cardview.widget.CardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_gravity="center_horizontal"
      android:layout_margin="10dp"
      android:padding="5dp"
      app:cardBackgroundColor="@color/white"
      app:cardCornerRadius="5dp">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_gravity="center_horizontal"
          android:gravity="center_horizontal"
          android:orientation="vertical">

            <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_gravity="center_horizontal"
              android:gravity="center"
              android:orientation="horizontal">

                <TextView
                  android:id="@+id/carname"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_gravity="center"
                  android:layout_margin="@dimen/_5sdp"
                  android:background="@drawable/bg_txt_yellow2"
                  android:fontFamily="@font/poppins_semibold"
                  android:gravity="center"
                  android:paddingHorizontal="@dimen/_5sdp"
                  android:paddingVertical="@dimen/_2sdp"
                  android:text="@string/status_other_issue"
                  android:textColor="#333333"
                  android:textSize="14sp" />

                <LinearLayout
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_margin="@dimen/_5sdp">

                    <androidx.cardview.widget.CardView
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:backgroundTint="#2d3791"
                      android:elevation="@dimen/_20sdp"
                      android:paddingHorizontal="@dimen/_5sdp"
                      android:paddingVertical="@dimen/_2sdp"
                      app:cardCornerRadius="@dimen/_10sdp">

                        <TextView
                          android:id="@+id/status"
                          android:layout_width="wrap_content"
                          android:layout_height="match_parent"
                          android:layout_gravity="center"
                          android:background="#2d3791"
                          android:fontFamily="@font/poppinsmedium"
                          android:gravity="end"
                          android:paddingHorizontal="@dimen/_10sdp"
                          android:paddingVertical="@dimen/_2sdp"
                          android:text="@string/status_other_issue"
                          android:textColor="#f0c419"
                          android:textSize="14sp" />

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

                <LinearLayout
                  android:id="@+id/llEdit"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_margin="@dimen/_5sdp">

                    <TextView
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:layout_gravity="center"
                      android:fontFamily="@font/poppinsmedium"
                      android:text="@string/edit"
                      android:textColor="#737373"
                      android:textSize="@dimen/_10sdp" />

                    <ImageView
                      android:paddingStart="@dimen/_2sdp"
                      android:layout_width="@dimen/_15sdp"
                      android:paddingEnd="1dp"
                      android:layout_height="wrap_content"
                      android:adjustViewBounds="true"
                      android:src="@drawable/ic_edit"
                      app:tint="#737373" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_gravity="center_horizontal"
              android:layout_marginStart="13dp"
              android:layout_marginTop="5dp"
              android:baselineAligned="false"
              android:gravity="center_horizontal"
              android:orientation="horizontal">

                <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_gravity="center"
                  android:layout_weight="1"
                  android:orientation="horizontal">

                    <ImageView
                      android:layout_width="15dp"
                      android:layout_height="15dp"
                      android:contentDescription="@string/location"
                      android:layout_gravity="center"
                      android:layout_marginStart="10dp"
                      android:src="@drawable/ic_location" />

                    <TextView
                      android:id="@+id/loacation"
                      android:layout_width="wrap_content"
                      android:layout_height="match_parent"
                      android:layout_gravity="center"
                      android:layout_marginEnd="10dp"
                      android:fontFamily="@font/poppinsmedium"
                      android:paddingStart="8dp"
                      android:paddingEnd="1dp"
                      android:text="@string/status_other_issue"
                      android:textColor="@color/black"
                      android:textSize="11sp" />

                </LinearLayout>

                <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:orientation="horizontal">

                    <ImageView
                      android:layout_width="15dp"
                      android:layout_height="15dp"
                      android:contentDescription="@string/date"
                      android:layout_gravity="center"
                      android:layout_marginStart="10dp"
                      android:src="@drawable/ic_date" />

                    <TextView
                      android:id="@+id/date"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:layout_gravity="center"
                      android:layout_marginEnd="10dp"
                      android:fontFamily="@font/poppinsmedium"
                      android:paddingStart="8dp"
                      android:paddingEnd="1dp"
                      android:paddingTop="4dp"
                      android:paddingBottom="4dp"
                      android:text="@string/status_other_issue"
                      android:textColor="@color/black"
                      android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_gravity="center_horizontal"
              android:layout_marginStart="13dp"
              android:layout_marginTop="5dp"
              android:layout_marginBottom="5dp"
              android:gravity="center_horizontal"
              android:orientation="horizontal">

                <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_gravity="center"
                  android:layout_weight="1"
                  android:orientation="horizontal">

                    <ImageView
                      android:layout_width="15dp"
                      android:layout_height="15dp"
                      android:contentDescription="@string/profile"
                      android:layout_gravity="center"
                      android:layout_marginStart="10dp"
                      android:src="@drawable/ic_driver" />

                    <TextView
                      android:id="@+id/driver"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:layout_gravity="center"
                      android:layout_marginEnd="10dp"
                      android:fontFamily="@font/poppinsmedium"
                      android:gravity="center"
                      android:paddingStart="8dp"
                      android:paddingEnd="1dp"
                      android:paddingTop="4dp"
                      android:paddingBottom="4dp"
                      android:text="@string/status_other_issue"
                      android:textColor="@color/black"
                      android:textSize="11sp" />

                </LinearLayout>

                <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:orientation="horizontal">

                    <ImageView
                      android:layout_width="15dp"
                      android:layout_height="15dp"
                      android:contentDescription="@string/distance"
                      android:layout_gravity="center"
                      android:layout_marginStart="10dp"
                      android:src="@drawable/ic_distance" />

                    <TextView
                      android:id="@+id/distance"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:layout_gravity="center"
                      android:layout_marginEnd="10dp"
                      android:fontFamily="@font/poppinsmedium"
                      android:paddingStart="8dp"
                      android:paddingEnd="1dp"
                      android:paddingTop="4dp"
                      android:paddingBottom="4dp"
                      android:text="@string/status_other_issue"
                      android:textColor="@color/black"
                      android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginHorizontal="13dp"
              android:orientation="horizontal">

                <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:orientation="horizontal">

                    <TextView
                      android:id="@+id/tvBHSD"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:layout_weight="1"
                      android:fontFamily="@font/poppins_semibold"
                      android:gravity="end"
                      android:text="@string/bhsd"
                      android:textColor="@color/black"
                      android:textSize="@dimen/_10sdp" />

                    <TextView
                      android:id="@+id/tvBHSDValue"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:layout_weight="1"
                      android:fontFamily="@font/poppinsmedium"
                      android:gravity="center_vertical"
                      android:text="@string/_0"
                      android:textColor="#FF4C43"
                      android:textSize="@dimen/_10sdp" />

                </LinearLayout>

                <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:orientation="horizontal">

                    <TextView
                      android:id="@+id/tvFHSD"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:layout_weight="1"
                      android:fontFamily="@font/poppins_semibold"
                      android:gravity="end"
                      android:text="@string/fhsd"
                      android:textColor="@color/black"
                      android:textSize="@dimen/_10sdp" />

                    <TextView
                      android:id="@+id/tvFHSDValue"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:layout_weight="1"
                      android:fontFamily="@font/poppinsmedium"
                      android:gravity="center_vertical"
                      android:text="@string/_0"
                      android:textColor="#FF4C43"
                      android:textSize="@dimen/_10sdp" />

                </LinearLayout>

                <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:orientation="horizontal">

                    <TextView
                      android:id="@+id/tvSHSD"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:layout_weight="1"
                      android:fontFamily="@font/poppins_semibold"
                      android:gravity="end"
                      android:text="@string/shsd"
                      android:textColor="@color/black"
                      android:textSize="@dimen/_10sdp" />

                    <TextView
                      android:id="@+id/tvSHSDValue"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:layout_weight="1"
                      android:fontFamily="@font/poppinsmedium"
                      android:gravity="center_vertical"
                      android:text="@string/_0"
                      android:textColor="#FF4C43"
                      android:textSize="@dimen/_10sdp" />

                </LinearLayout>

                <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:orientation="horizontal">

                    <TextView
                      android:id="@+id/tvADV"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:layout_weight="1"
                      android:fontFamily="@font/poppins_semibold"
                      android:gravity="end"
                      android:text="@string/adv"
                      android:textColor="@color/black"
                      android:textSize="@dimen/_10sdp" />

                    <TextView
                      android:id="@+id/tvADVValue"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:layout_weight="1"
                      android:fontFamily="@font/poppinsmedium"
                      android:gravity="center_vertical"
                      android:text="@string/_0"
                      android:textColor="#FF4C43"
                      android:textSize="@dimen/_10sdp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>