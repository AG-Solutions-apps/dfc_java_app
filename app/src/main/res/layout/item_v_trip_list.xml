<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

  <androidx.cardview.widget.CardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_margin="10dp"
      android:padding="5dp"
      app:cardCornerRadius="5dp"
      app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

      <!-- Header Row: Car Name and Status -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:layout_marginStart="13dp"
          android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_car_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:background="@drawable/bg_txt_yellow2"
            android:fontFamily="@font/poppins_semi_bold"
            android:paddingHorizontal="15dp"
            android:paddingVertical="4dp"
            android:text="@string/status_other_issue"
            android:textColor="#333333"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end">

          <androidx.cardview.widget.CardView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginEnd="25dp"
              android:layout_marginTop="5dp"
              android:paddingTop="4dp"
              android:elevation="@dimen/_20sdp"
              app:cardCornerRadius="@dimen/_10sdp"
              android:backgroundTint="#2d3791">

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="#2d3791"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:paddingHorizontal="15dp"
                android:text="@string/status_other_issue"
                android:textColor="#f0c419"
                android:textSize="14sp" />

          </androidx.cardview.widget.CardView>

        </LinearLayout>

      </LinearLayout>

      <!-- Row: Location and Date -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="5dp"
          android:layout_marginStart="13dp"
          android:baselineAligned="false"
          android:gravity="center"
          android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            tools:ignore="UseCompoundDrawables">

          <ImageView
              android:layout_width="15dp"
              android:layout_height="15dp"
              android:layout_marginStart="10dp"
              android:contentDescription="@string/location"
              android:src="@drawable/ic_location" />

          <TextView
              android:id="@+id/tv_location"
              android:layout_width="wrap_content"
              android:layout_height="match_parent"
              android:fontFamily="@font/poppins_medium"
              android:paddingStart="8dp"
              android:paddingEnd="@dimen/_1sdp"
              android:text="@string/status_other_issue"
              android:textColor="@color/black"
              android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            tools:ignore="UseCompoundDrawables">

          <ImageView
              android:layout_width="15dp"
              android:layout_height="15dp"
              android:layout_marginStart="10dp"
              android:contentDescription="@string/date"
              android:src="@drawable/ic_date" />

          <TextView
              android:id="@+id/tv_date"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="@font/poppins_medium"
              android:paddingStart="8dp"
              android:paddingEnd="@dimen/_1sdp"
              android:paddingVertical="4dp"
              android:text="@string/status_other_issue"
              android:textColor="@color/black"
              android:textSize="11sp" />
        </LinearLayout>
      </LinearLayout>

      <!-- Row: Drivers and Distance -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="5dp"
          android:layout_marginBottom="5dp"
          android:layout_marginStart="13dp"
          android:baselineAligned="false"
          android:gravity="center"
          android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            tools:ignore="UseCompoundDrawables">

          <ImageView
              android:layout_width="15dp"
              android:layout_height="15dp"
              android:layout_marginStart="10dp"
              android:contentDescription="@string/driver"
              android:src="@drawable/ic_driver" />

          <TextView
              android:id="@+id/tv_drivers"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="@font/poppins_medium"
              android:paddingStart="8dp"
              android:paddingEnd="@dimen/_1sdp"
              android:paddingVertical="4dp"
              android:text="@string/status_other_issue"
              android:textColor="@color/black"
              android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            tools:ignore="UseCompoundDrawables">

          <ImageView
              android:layout_width="15dp"
              android:layout_height="15dp"
              android:layout_marginStart="10dp"
              android:contentDescription="@string/distance"
              android:src="@drawable/ic_distance" />

          <TextView
              android:id="@+id/tv_distance"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="@font/poppins_medium"
              android:paddingStart="8dp"
              android:paddingEnd="@dimen/_1sdp"
              android:paddingVertical="4dp"
              android:text="@string/status_other_issue"
              android:textColor="@color/black"
              android:textSize="11sp" />
        </LinearLayout>

      </LinearLayout>

    </LinearLayout>

  </androidx.cardview.widget.CardView>

</LinearLayout>