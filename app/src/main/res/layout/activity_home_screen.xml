<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="#F5F5F5"
  android:orientation="vertical"
  tools:context=".Activity.HomeScreen">

    <ScrollView
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:background="@color/white">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical">

            <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginBottom="4dp"
              android:background="@drawable/bg_home_top"
              android:elevation="4dp"
              android:orientation="vertical"
              android:paddingBottom="20dp">

                <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="50dp"
                  android:layout_marginBottom="5dp"
                  android:orientation="horizontal">

                    <ImageView
                      android:layout_width="27dp"
                      android:layout_height="27dp"
                      android:layout_gravity="center"
                      android:layout_marginStart="15dp"
                      android:src="@drawable/ic_menu_home"
                      android:contentDescription="@string/home"
                      android:visibility="gone" />

                    <TextView
                      android:layout_width="0dp"
                      android:layout_height="match_parent"
                      android:layout_marginStart="10dp"
                      android:layout_marginEnd="10dp"
                      android:layout_weight="1"
                      android:fontFamily="@font/poppinsmedium"
                      android:gravity="start|center"
                      android:text="@string/app_name"
                      android:textColor="@color/white"
                      android:textSize="18sp" />

                    <ImageView
                      android:id="@+id/logout"
                      android:layout_width="27dp"
                      android:layout_height="27dp"
                      android:layout_gravity="center"
                      android:layout_marginEnd="15dp"
                      android:src="@drawable/ic_logout"
                      android:visibility="gone"
                      android:contentDescription="@string/logout"
                      />

                </LinearLayout>

                <TextView
                  android:id="@+id/branchname"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_gravity="end"
                  android:layout_marginStart="10dp"
                  android:layout_marginEnd="10dp"
                  android:layout_marginBottom="10dp"
                  android:background="@drawable/bg_txt_yellow"
                  android:fontFamily="@font/poppins_semibold"
                  android:gravity="end"
                  android:paddingStart="15dp"
                  android:paddingEnd="15dp"
                  android:text="@string/branch_name"
                  android:textColor="#333333"
                  android:textSize="14sp" />

                <TextView
                  android:id="@+id/branchnameadmin"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_gravity="end"
                  android:layout_marginStart="10dp"
                  android:layout_marginEnd="10dp"
                  android:layout_marginBottom="10dp"
                  android:background="@drawable/bg_txt_yellow"
                  app:drawableRightCompat="@drawable/baseline_arrow_drop_down_24"
                  android:fontFamily="@font/poppins_semibold"
                  android:gravity="end"
                  android:paddingStart="15dp"
                  android:paddingEnd="5dp"
                  android:text="@string/branch_name"
                  android:textColor="#333333"
                  android:textSize="14sp" />

                <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:orientation="horizontal">


                    <ImageView
                      android:layout_width="210dp"
                      android:layout_height="130dp"
                      android:layout_gravity="center"
                      android:scaleType="fitXY"
                      android:contentDescription="@string/app_name"
                      android:src="@drawable/ic_truck_home" />

                    <LinearLayout
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:layout_gravity="center"
                      android:layout_marginTop="28dp"
                      android:orientation="vertical">

                        <TextView
                          android:layout_width="match_parent"
                          android:layout_height="wrap_content"
                          android:layout_marginStart="10dp"
                          android:layout_marginEnd="10dp"
                          android:fontFamily="@font/poppins_regular"
                          android:gravity="end"
                          android:text="@string/welcome"
                          android:textColor="#C1FFFFFF"
                          android:textSize="16sp" />

                        <TextView
                          android:id="@+id/username"
                          android:layout_width="match_parent"
                          android:layout_height="wrap_content"
                          android:layout_marginStart="10dp"
                          android:layout_marginEnd="10dp"
                          android:fontFamily="@font/poppins_semibold"
                          android:gravity="end"
                          android:text="@string/testingdriver"
                          android:textColor="@color/dark_yellow"
                          android:textSize="18sp"
                          android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
              android:id="@+id/mainview"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical">

                <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="15dp"
                  android:baselineAligned="false"
                  android:orientation="horizontal">

                    <LinearLayout
                      android:id="@+id/vhivlelivk"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:layout_weight="1"
                      android:orientation="vertical">

                        <ImageView
                          android:layout_width="match_parent"
                          android:layout_height="80dp"
                          android:layout_gravity="center"
                          android:src="@drawable/home1" />

                        <TextView
                          android:layout_width="match_parent"
                          android:layout_height="match_parent"
                          android:layout_marginStart="10dp"
                          android:layout_marginTop="8dp"
                          android:layout_marginEnd="10dp"
                          android:layout_marginBottom="8dp"
                          android:fontFamily="@font/poppinsmedium"
                          android:gravity="center"
                          android:text="@string/trips"
                          android:textColor="@color/black"
                          android:textSize="14sp" />

                    </LinearLayout>

                    <LinearLayout
                      android:id="@+id/payment"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:layout_weight="1"
                      android:orientation="vertical">

                        <ImageView
                          android:layout_width="match_parent"
                          android:layout_height="80dp"
                          android:layout_gravity="center"
                          android:src="@drawable/home2"
                          android:contentDescription="@string/payment"
                          />

                        <TextView
                          android:layout_width="match_parent"
                          android:layout_height="match_parent"
                          android:layout_marginStart="10dp"
                          android:layout_marginTop="8dp"
                          android:layout_marginEnd="10dp"
                          android:layout_marginBottom="8dp"
                          android:fontFamily="@font/poppinsmedium"
                          android:gravity="center"
                          android:text="@string/payment"
                          android:textColor="@color/black"
                          android:textSize="14sp" />

                    </LinearLayout>

                    <LinearLayout
                      android:id="@+id/expence"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:layout_weight="1"
                      android:orientation="vertical">

                        <ImageView
                          android:layout_width="match_parent"
                          android:layout_height="80dp"
                          android:layout_gravity="center"
                          android:contentDescription="@string/expenses"
                          android:src="@drawable/home3" />

                        <TextView
                          android:layout_width="match_parent"
                          android:layout_height="match_parent"
                          android:layout_marginStart="10dp"
                          android:layout_marginTop="8dp"
                          android:layout_marginEnd="10dp"
                          android:layout_marginBottom="8dp"
                          android:fontFamily="@font/poppinsmedium"
                          android:gravity="center"
                          android:text="@string/expenses"
                          android:textColor="@color/black"
                          android:textSize="14sp" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:orientation="horizontal">

                    <LinearLayout
                      android:id="@+id/driver"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:layout_weight="1"
                      android:orientation="vertical">

                        <ImageView
                          android:layout_width="match_parent"
                          android:layout_height="80dp"
                          android:layout_gravity="center"
                          android:src="@drawable/home4"
                          android:contentDescription="@string/drivers"
                          />

                        <TextView
                          android:layout_width="match_parent"
                          android:layout_height="match_parent"
                          android:layout_marginStart="10dp"
                          android:layout_marginTop="8dp"
                          android:layout_marginEnd="10dp"
                          android:layout_marginBottom="8dp"
                          android:fontFamily="@font/poppinsmedium"
                          android:gravity="center"
                          android:text="@string/drivers"
                          android:textColor="@color/black"
                          android:textSize="14sp" />

                    </LinearLayout>

                    <LinearLayout
                      android:id="@+id/service"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:layout_weight="1"
                      android:orientation="vertical">

                        <ImageView
                          android:layout_width="match_parent"
                          android:layout_height="80dp"
                          android:layout_gravity="center"
                          android:src="@drawable/home5"
                          android:contentDescription="@string/service"
                          />

                        <TextView
                          android:layout_width="match_parent"
                          android:layout_height="match_parent"
                          android:layout_marginStart="10dp"
                          android:layout_marginTop="8dp"
                          android:layout_marginEnd="10dp"
                          android:layout_marginBottom="8dp"
                          android:fontFamily="@font/poppinsmedium"
                          android:gravity="center"
                          android:text="@string/service"
                          android:textColor="@color/black"
                          android:textSize="14sp" />

                    </LinearLayout>

                    <LinearLayout
                      android:id="@+id/todolis"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:layout_weight="1"
                      android:orientation="vertical">


                        <RelativeLayout
                          android:layout_width="match_parent"
                          android:layout_height="wrap_content">

                            <ImageView
                              android:layout_width="match_parent"
                              android:layout_height="80dp"
                              android:layout_gravity="center"
                              android:src="@drawable/home6"
                              android:contentDescription="@string/to_do_list"
                              />

                            <TextView
                              android:id="@+id/totaltodo"
                              android:layout_width="wrap_content"
                              android:layout_height="wrap_content"
                              android:layout_alignParentEnd="true"
                              android:layout_marginEnd="30dp"
                              android:background="@drawable/acceptbtn2"
                              android:gravity="center"
                              android:paddingStart="7dp"
                              android:paddingEnd="7dp"
                              android:text="@string/_0_"
                              android:textColor="@color/white"
                              android:textSize="16sp"
                              android:textStyle="bold" />

                        </RelativeLayout>

                        <TextView
                          android:layout_width="match_parent"
                          android:layout_height="match_parent"
                          android:layout_marginStart="10dp"
                          android:layout_marginTop="8dp"
                          android:layout_marginEnd="10dp"
                          android:layout_marginBottom="8dp"
                          android:fontFamily="@font/poppinsmedium"
                          android:gravity="center"
                          android:text="@string/to_do_list"
                          android:textColor="@color/black"
                          android:textSize="14sp" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:orientation="horizontal">

                    <LinearLayout
                      android:id="@+id/allvhicle"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:layout_weight="1"
                      android:orientation="vertical">

                        <ImageView
                          android:layout_width="match_parent"
                          android:layout_height="80dp"
                          android:layout_gravity="center"
                          android:src="@drawable/home1" />

                        <TextView
                          android:layout_width="match_parent"
                          android:layout_height="match_parent"
                          android:layout_marginStart="10dp"
                          android:layout_marginTop="8dp"
                          android:layout_marginEnd="10dp"
                          android:layout_marginBottom="8dp"
                          android:fontFamily="@font/poppinsmedium"
                          android:gravity="center"
                          android:text="@string/vehicle"
                          android:textColor="@color/black"
                          android:textSize="14sp" />

                    </LinearLayout>

                    <LinearLayout
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:layout_weight="1"
                      android:orientation="vertical" />

                    <LinearLayout
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:layout_weight="1"
                      android:orientation="vertical" />

                </LinearLayout>

                <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginStart="10dp"
                  android:layout_marginTop="15dp"
                  android:layout_marginEnd="10dp"
                  android:orientation="horizontal">

                    <ImageView
                      android:id="@+id/creattrip"
                      android:layout_width="0dp"
                      android:layout_height="60dp"
                      android:layout_gravity="center"
                      android:layout_marginEnd="5dp"
                      android:layout_weight="1"
                      android:src="@drawable/trip_btn" />

                </LinearLayout>

            </LinearLayout>

            <com.airbnb.lottie.LottieAnimationView
              android:id="@+id/comingsun"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_gravity="center"
              android:foregroundGravity="center"
              android:paddingTop="5dp"
              android:paddingBottom="5dp"
              android:visibility="gone"
              app:lottie_autoPlay="true"
              app:lottie_loop="true"
              app:lottie_rawRes="@raw/coming" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>